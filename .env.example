RC_SRT_HOST=example.com
RC_SRT_PORT=9000
RC_SRT_LATENCY=800
# No RC_SRT_PASSPHRASE: SRT runs unencrypted, inside a WireGuard tunnel to the
# receiver instead — encrypting twice would just cost CPU/latency for nothing.

RC_MODEM_NMEA_PORT=/dev/ttyUSB1

# GPS time discipline (internal/modem/gpsclock.go) — unset (default) = disabled.
# Set to a small non-negative integer (0 is the conventional first unit) to
# publish GPS-derived UTC time to chrony's SHM refclock interface whenever an
# active RMC fix is read, so the system clock (no battery-backed RTC on this
# carrier board) can be disciplined from GPS instead of relying on cellular
# NTP, which may be degraded/absent for stretches during a rally.
# Requires matching system configuration this repo does not manage:
#   refclock SHM 0 poll 4 refid GPS precision 1e-1
#   makestep 1.0 1   # exactly one step allowed (the first correction), slew after
# RC_GPS_SHM_UNIT=0

# Radio mode/band profile (internal/modem/radio_profile.go) — reapplied every
# time the modem (re)attaches: startup, USB re-enumeration, or a watchdog
# reset. ModemManager doesn't persist these to the modem's NV storage, hence
# reapplying rather than a one-time AT+QCFG-style setting.
# RC_MODEM_ALLOWED_MODES=3g|4g|5g   # modes to allow (this never narrows capability)
# RC_MODEM_PREFERRED_MODE=4g        # which to prefer. 5G NR is rare outside towns/
                                     # motorways in France; preferring it in remote
                                     # stage areas mostly just adds scan-cycle latency
                                     # for coverage you won't get there anyway.
# RC_MODEM_BANDS=                   # empty = no restriction (recommended default).
                                     # Locking bands (e.g. eutran-20|eutran-8 for
                                     # low-band LTE range) can help in known-poor
                                     # coverage, but if those bands aren't actually
                                     # deployed by your carrier at a given stage, the
                                     # modem gets ZERO service instead of falling back
                                     # to another band — only set this after confirming
                                     # real band deployment for the region.

# Health watchdog (internal/modem/watchdog.go) — all optional, shown with defaults.
# RC_MODEM_IFACE=wwan0                  # interface the reachability probe is bound to
# RC_MODEM_PROBE_TARGETS=1.1.1.1:443,8.8.8.8:443  # comma-separated host:port, reachable if ANY answers
# RC_MODEM_PROBE_INTERVAL=10            # seconds between reachability probes
# RC_MODEM_PROBE_TIMEOUT=5              # seconds per dial attempt
# RC_MODEM_FAIL_THRESHOLD=3             # consecutive failed probes before nudging a reconnect
# RC_MODEM_SOFT_GRACE=20                # seconds to wait after a reconnect nudge before escalating
# RC_MODEM_RESET_GRACE=45               # seconds to wait after a modem reset before escalating again
# RC_MODEM_CIRCUIT_WINDOW=900           # rolling window (seconds) for the reset circuit breaker
# RC_MODEM_CIRCUIT_MAX_RESETS=3         # resets within the window that trips the breaker
# RC_MODEM_CIRCUIT_BACKOFF=600          # seconds the breaker stays open once tripped

RC_UPS_ADDR=0x40
RC_UPS_BUS=7

RC_VIDEO_BITRATE=12000000
# No RC_AUDIO_BITRATE: it used to configure the AAC record path's bitrate, but
# that path now writes uncompressed PCM (BWF/WAV, see
# internal/pipeline/bwf.go) instead of encoding, so there's nothing to
# configure there. The audio *streaming* path's Opus bitrate is unrelated and
# always comes from devices.yaml's per-microphone stream.bitrate.

RC_VIDEO_INTRA_REFRESH=30  # intra-refresh period in frames (0 or unset = disabled; uses IDR-based encoding)

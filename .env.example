# LiveKit
LIVEKIT_URL=wss://live.minarox.fr
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=racecast
LIVEKIT_IDENTITY=racecast-car

# Storage
DISK_CRITICAL_GB=5
DEVICES_FILE=./devices.yml
RECORDINGS_DIR=./records
LOG_DIR=./logs
RUST_LOG=info

# Video
VIDEO_MAX_RESOLUTION=1920x1080
VIDEO_MAX_FPS=60
VIDEO_BITRATE_KBPS=12000
STREAM_VIDEO_ENABLED=true
STREAM_VIDEO_RESOLUTION=960x540
STREAM_VIDEO_FPS=30
STREAM_VIDEO_BITRATE_KBPS=1200

# Audio
AUDIO_SAMPLE_RATE=48000
STREAM_AUDIO_ENABLED=true
STREAM_AUDIO_BITRATE_KBPS=64

# Telemetry
GPS_INTERVAL_MS=1000
MODEM_INTERVAL_MS=5000
UPS_INTERVAL_MS=2000
SYSTEM_INTERVAL_MS=5000
UPS_I2C_BUS=7
UPS_I2C_ADDRESS=0x41

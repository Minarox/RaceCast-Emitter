{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "devices.schema.json",
    "title": "DevicesConfig",
    "description": "Configuration des caméras et microphones pour RaceCast-Emitter.",
    "type": "object",
    "required": ["cameras", "microphones"],
    "additionalProperties": false,
    "properties": {
        "cameras": {
            "type": "array",
            "description": "Liste des caméras vidéo.",
            "items": {
                "type": "object",
                "required": ["name", "device", "width", "height", "framerate", "bitrate"],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nom du flux vidéo publié sur LiveKit."
                    },
                    "device": {
                        "type": "string",
                        "description": "Chemin du périphérique V4L2.",
                        "examples": ["/dev/video0"]
                    },
                    "width": {
                        "type": "integer",
                        "description": "Largeur de la vidéo en pixels.",
                        "minimum": 1
                    },
                    "height": {
                        "type": "integer",
                        "description": "Hauteur de la vidéo en pixels.",
                        "minimum": 1
                    },
                    "framerate": {
                        "type": "integer",
                        "description": "Fréquence d'images par seconde.",
                        "minimum": 1,
                        "maximum": 120
                    },
                    "bitrate": {
                        "type": "integer",
                        "description": "Débit binaire cible en bits par seconde.",
                        "minimum": 1
                    },
                    "enabled": {
                        "type": "boolean",
                        "description": "Active ou désactive ce flux vidéo.",
                        "default": true
                    }
                }
            }
        },
        "microphones": {
            "type": "array",
            "description": "Liste des microphones audio.",
            "items": {
                "type": "object",
                "required": ["name", "device", "sample_rate", "channels", "bitrate"],
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nom du flux audio publié sur LiveKit."
                    },
                    "device": {
                        "type": "string",
                        "description": "Identifiant du périphérique ALSA.",
                        "examples": ["hw:2,0"]
                    },
                    "sample_rate": {
                        "type": "integer",
                        "description": "Fréquence d'échantillonnage en Hz.",
                        "enum": [8000, 16000, 22050, 44100, 48000, 96000]
                    },
                    "channels": {
                        "type": "integer",
                        "description": "Nombre de canaux audio.",
                        "minimum": 1,
                        "maximum": 8
                    },
                    "bitrate": {
                        "type": "integer",
                        "description": "Débit binaire cible en bits par seconde.",
                        "minimum": 1
                    },
                    "enabled": {
                        "type": "boolean",
                        "description": "Active ou désactive ce flux audio.",
                        "default": true
                    }
                }
            }
        }
    }
}
